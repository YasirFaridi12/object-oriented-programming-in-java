class Car {

    String brand;

    // Constructor
    Car(String b) {
        brand = b;
    }

    void show() {
        System.out.println("Car Brand: " + brand);
    }
}

public class ConstructorExample {

    public static void main(String[] args) {

        Car c1 = new Car("BMW");

        c1.show();
    }
}
