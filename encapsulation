class Employee {

    private int salary;

    public void setSalary(int salary) {
        this.salary = salary;
    }

    public int getSalary() {
        return salary;
    }
}

public class EncapsulationExample {

    public static void main(String[] args) {

        Employee emp = new Employee();

        emp.setSalary(50000);

        System.out.println("Salary: " + emp.getSalary());
    }
}
